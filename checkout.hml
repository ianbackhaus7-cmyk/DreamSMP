<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Checkout | DreamSMP</title>

<link rel="stylesheet" href="style.css">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style>

body{
    background:#09080d;
    color:white;
    font-family:Poppins,sans-serif;
}

.checkout{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    padding:120px 20px;
}

.box{
    width:600px;
    background:#13111d;
    border-radius:18px;
    padding:40px;
    border:1px solid rgba(255,255,255,.08);
}

.box h1{
    text-align:center;
    margin-bottom:30px;
    color:#9d62ff;
}

.row{
    display:flex;
    justify-content:space-between;
    margin:20px 0;
    font-size:20px;
}

.buy{
    width:100%;
    margin-top:35px;
    padding:18px;
    background:#7d33ff;
    color:white;
    border:none;
    border-radius:12px;
    font-size:18px;
    cursor:pointer;
}

.buy:hover{
    background:#9254ff;
}

.back{
    display:block;
    text-align:center;
    margin-top:20px;
    color:#9d62ff;
    text-decoration:none;
}

</style>

</head>

<body>

<section class="checkout">

<div class="box">

<h1>Bestellung</h1>

<div class="row">
<span>Spieler:</span>
<strong id="player"></strong>
</div>

<div class="row">
<span>Produkt:</span>
<strong id="product"></strong>
</div>

<div class="row">
<span>Preis:</span>
<strong id="price"></strong>
</div>

<button class="buy" onclick="pay()">
Jetzt bezahlen
</button>

<a href="index.html" class="back">
← Zurück zur Startseite
</a>

</div>

</section>

<script>

document.getElementById("player").innerHTML=localStorage.getItem("player");
document.getElementById("product").innerHTML=localStorage.getItem("product");
document.getElementById("price").innerHTML=localStorage.getItem("price");

function pay(){

alert("Hier wird später PayPal oder Stripe eingebunden.");

}

</script>

</body>
</html>